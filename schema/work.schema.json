{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work.schema.json",
  "title": "Work record",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/base"
    }
  ],
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/workId"
    },
    "type": {
      "const": "work"
    },
    "author_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/personId"
      }
    },
    "authorship_certainty": {
      "$ref": "common.schema.json#/$defs/grade"
    },
    "composed": {
      "$ref": "common.schema.json#/$defs/historicalDate"
    },
    "earliest_witness": {
      "type": "string"
    },
    "structure": {
      "type": "string"
    },
    "versions_and_translations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceId"
      }
    }
  },
  "required": []
}